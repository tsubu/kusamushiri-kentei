# ============================================================
# 草むしり検定実技：公開設定（Apache / MAMP）
# ============================================================

# フォルダの中身を一覧表示しない
Options -Indexes

# 隠しファイル・隠しフォルダ（.claude/ .htaccess など）と DB・鍵ファイルを外から見せない
RedirectMatch 404 "(^|/)\."
<FilesMatch "\.(sqlite3|sqlite3-wal|sqlite3-shm|key|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# セキュリティ用のレスポンスヘッダー
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
